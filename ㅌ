
<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
<meta name="theme-color" content="#f5f5f7">
<title>Baekhyun iPhone</title>
<style>
:root{--bg:#f5f5f7;--ink:#17171a;--muted:#85858d;--blue:#087cff;--card:#fff;--line:#e8e8ed}
*{box-sizing:border-box}
html,body{margin:0;width:100%;height:100%;overflow:hidden;font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display","Helvetica Neue",sans-serif;color:var(--ink);background:#111}
button,input{font:inherit}
button{cursor:pointer;color:inherit;border:0}
#device{position:relative;width:100%;height:100dvh;overflow:hidden;background:#f5f5f7;isolation:isolate}
#wallpaper{position:absolute;inset:0;background:linear-gradient(155deg,#9babc5,#e3c8d4 48%,#6f7e9d);background-size:cover;background-position:center;z-index:-2}
#wallpaper:after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,#0002,transparent 35%,#0002)}
#status{position:absolute;z-index:30;top:0;left:0;right:0;height:54px;padding:13px 26px 0;display:flex;justify-content:space-between;align-items:flex-start;font-size:15px;font-weight:650;color:#fff;pointer-events:none}
.statusright{display:flex;gap:6px;align-items:center}
#island{position:absolute;z-index:31;top:11px;left:50%;transform:translateX(-50%);width:118px;height:34px;background:#080808;border-radius:24px;transition:.2s}
#island.open{width:220px;height:65px}
#screens{position:absolute;inset:0}
.screen{display:none;position:absolute;inset:0;overflow-y:auto;overscroll-behavior:contain;scrollbar-width:none}
.screen::-webkit-scrollbar{display:none}
.screen.active{display:block;animation:appear .17s ease}
@keyframes appear{from{opacity:.7}to{opacity:1}}
#lock{color:white;text-align:center;background:linear-gradient(155deg,#6d829e,#c9a9bd 55%,#465b79);background-size:cover;background-position:center;padding-top:clamp(100px,18vh,160px)}
#lock:before{content:"";position:absolute;inset:0;background:linear-gradient(#0001,#0002 60%,#0004);pointer-events:none}
.lockdate,.locktime,#locknote,#unlockhint{position:relative;z-index:1}
.lockdate{font-size:18px;font-weight:500}
.locktime{font-size:clamp(75px,21vw,104px);font-weight:200;letter-spacing:-5px;line-height:1.12}
#locknote{margin:32px 20px 0;padding:14px;text-align:left;background:#ffffff38;backdrop-filter:blur(25px);border:1px solid #ffffff22;border-radius:18px;font-size:14px}
.notehead{font-weight:700;margin-bottom:5px}
#unlockhint{position:absolute;bottom:65px;left:0;right:0;font-size:13px;color:#fff}
#unlockhint span{display:block;font-size:24px;margin-bottom:5px;animation:bob 1.4s infinite}
@keyframes bob{50%{transform:translateY(5px)}}
#home{padding:72px 23px 112px;color:white;background:linear-gradient(160deg,#8396b4,#e4cbd9 48%,#637796);background-size:cover;background-position:center}
.welcome{font-size:14px;margin:8px 0 5px;text-shadow:0 1px 3px #0002}
#home h1{font-size:27px;font-weight:650;letter-spacing:-.6px;margin:0 0 20px}
.widget{background:#ffffff32;backdrop-filter:blur(22px);border:1px solid #ffffff35;border-radius:22px;padding:14px;margin-bottom:24px}
.widgettop{display:flex;justify-content:space-between;font-size:12px;opacity:.9}
.widgettime{font-size:32px;margin-top:4px;font-weight:300}
.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:23px 8px}
.app{text-align:center;min-width:0;background:transparent;color:inherit;padding:0}
.appicon{width:min(17vw,63px);height:min(17vw,63px);border-radius:22%;margin:auto auto 6px;display:grid;place-items:center;font-size:min(8vw,32px);box-shadow:0 3px 8px #0002;position:relative;overflow:hidden}
.appicon svg{width:58%;height:58%}
.appname{font-size:11px;white-space:nowrap;text-shadow:0 1px 4px #0004}
.icon-photo{background:conic-gradient(#7dd7a3,#f9d35b,#f28da9,#9c9aff,#7dd7a3)}
.icon-phone{background:#32c65c}
.icon-msg{background:#36ca62}
.icon-kakao{background:#fee500;color:#241f12}
.icon-safari{background:#fff;color:#1675e9}
.icon-setting{background:linear-gradient(#d7d7dc,#8e8e94);color:white}
.icon-music{background:linear-gradient(145deg,#f78ba8,#7b56b5)}
.icon-notes{background:linear-gradient(#fff 0 15%,#f4e5a9 15%);color:#c6a447}
.icon-calendar{background:#fff;color:#d84d49;font-size:10px;font-weight:700}
.icon-camera{background:linear-gradient(145deg,#606069,#222)}
.icon-weather{background:linear-gradient(145deg,#55c4ff,#5675d8)}
.icon-clock{background:#fff;color:#25252a}
.icon-files{background:#4ca9f4}
.dock{position:absolute;z-index:15;bottom:calc(12px + env(safe-area-inset-bottom));left:16px;right:16px;height:91px;padding:13px 9px;border-radius:28px;background:#ffffff46;backdrop-filter:blur(32px);display:flex;justify-content:space-around;align-items:center;border:1px solid #ffffff40}
.dock .appicon{width:min(16vw,59px);height:min(16vw,59px);margin:0}
.dock .appname{display:none}
.bar{position:sticky;top:0;z-index:5;display:flex;align-items:center;justify-content:space-between;padding:58px 20px 13px;background:#f5f5f7ed;backdrop-filter:blur(20px)}
.bar h2{font-size:27px;margin:0;font-weight:750;letter-spacing:-.7px}
.bar button{font-size:15px;color:var(--blue);background:transparent;padding:6px}
.page{padding:8px 17px 100px;background:#f5f5f7;min-height:100%;color:var(--ink)}
.search{width:100%;padding:11px 13px;background:#e7e7ec;border-radius:11px;border:0;outline:none;font-size:16px;margin:4px 0 14px}
.card{background:white;border-radius:15px;padding:14px;margin-bottom:12px}
.rowitem{display:flex;align-items:center;gap:12px;min-height:60px;border-bottom:1px solid var(--line);padding:10px 0}
.rowitem:last-child{border-bottom:0}
.avatar{width:45px;height:45px;flex-shrink:0;border-radius:50%;display:grid;place-items:center;background:#e6d6e1;font-size:22px;overflow:hidden}
.avatar img{width:100%;height:100%;object-fit:cover}
.rowmain{flex:1;min-width:0}
.rowtitle{font-size:16px;font-weight:600}
.rowdesc{font-size:13px;color:var(--muted);margin-top:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.smalltime{font-size:11px;color:var(--muted)}
.sectiontitle{font-size:13px;color:var(--muted);margin:18px 5px 8px}
.photoGrid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:3px}
.photoTile{aspect-ratio:1;border:0;padding:0;position:relative;overflow:hidden;background:linear-gradient(145deg,#d9c0cf,#8c9cb5);display:grid;place-items:center;color:#fff}
.photoTile img{width:100%;height:100%;object-fit:cover;position:absolute;inset:0}
.photoTile span{position:relative;font-size:11px;text-shadow:0 1px 4px #000}
#viewer{z-index:60;background:#090909;color:white;padding:50px 0 80px;text-align:center}
#viewer img{width:100%;height:68vh;object-fit:contain}
#viewer .close{position:absolute;top:20px;left:20px;font-size:26px;color:white;background:#3338;border-radius:50%;width:40px;height:40px}
#viewer p{padding:10px}
.phoneTabs{position:fixed;z-index:10;bottom:0;left:0;right:0;background:#fafafcf0;backdrop-filter:blur(20px);display:flex;justify-content:space-around;padding:10px 0 calc(20px + env(safe-area-inset-bottom));border-top:1px solid #ddd}
.phoneTabs button{display:flex;flex-direction:column;gap:4px;align-items:center;font-size:10px;color:#777;background:none}
.phoneTabs button b{font-size:23px;font-weight:400}
.phoneTabs button.selected{color:#31b85a}
#phone .page,#messages .page,#kakao .page,#gallery .page,#safari .page,#settings .page,#contacts .page,#music .page{padding-bottom:110px}
.keypad{display:grid;grid-template-columns:repeat(3,1fr);gap:13px;max-width:290px;margin:20px auto}
.key{height:68px;border-radius:50%;background:#e4e4e9;font-size:26px;display:flex;flex-direction:column;align-items:center;justify-content:center}
.key small{font-size:9px;letter-spacing:2px}
.callbutton{display:block;margin:18px auto;background:#32c65c;color:white;border-radius:50%;width:62px;height:62px;font-size:25px}
.chathead{display:flex;align-items:center;gap:12px;padding:12px 18px;background:#f5f5f7;position:sticky;top:0;z-index:3}
.chatbody{padding:18px 13px 95px;min-height:55vh;background:#f3f1ed}
.bubble{max-width:82%;width:max-content;padding:11px 14px;border-radius:18px;background:white;margin:10px 0;font-size:15px;white-space:pre-wrap;overflow-wrap:anywhere}
.bubble.mine{margin-left:auto;background:#9ce878}
.chatinput{position:fixed;bottom:0;left:0;right:0;z-index:12;display:flex;gap:8px;padding:10px 12px calc(23px + env(safe-area-inset-bottom));background:#fafafcf2}
.chatinput input{flex:1;min-width:0;border:1px solid #ddd;border-radius:22px;padding:11px 15px;background:white;outline:none}
.send{background:#1684ff;color:white;border-radius:50%;width:40px;height:40px;font-weight:700}
#control{z-index:70;background:#dfe5edeb;backdrop-filter:blur(30px);padding:65px 18px 45px}
.controlgrid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
.controltile{background:#ffffffa8;border-radius:20px;padding:17px;min-height:90px}
.controltile button{background:#fff;border-radius:30px;padding:8px 12px;margin-top:10px}
.slider{width:100%;accent-color:#1684ff}
#shade{z-index:65;background:#dfe5edee;backdrop-filter:blur(28px);padding:65px 18px}
#shade h2{font-size:30px}
#homeindicator{position:absolute;z-index:80;bottom:calc(7px + env(safe-area-inset-bottom));left:50%;transform:translateX(-50%);width:135px;height:5px;background:#fff;border-radius:8px;box-shadow:0 1px 3px #0002;touch-action:none}
#homeindicator.dark{background:#222}
#toast{position:absolute;z-index:100;top:65px;left:50%;transform:translateX(-50%);background:#222d;color:#fff;border-radius:20px;padding:10px 16px;font-size:13px;opacity:0;pointer-events:none;transition:.2s;white-space:nowrap}
#toast.show{opacity:1}
.settingrow{display:flex;align-items:center;justify-content:space-between;padding:15px 0;border-bottom:1px solid var(--line);font-size:15px}
.toggle{width:46px;height:27px;border-radius:20px;background:#c7c7cc;padding:3px}
.toggle:after{content:"";display:block;background:white;width:21px;height:21px;border-radius:50%;transition:.2s}
.toggle.on{background:#34c759}
.toggle.on:after{transform:translateX(19px)}
@media(min-width:600px){
 body{display:grid;place-items:center;background:#202024}
 #device{width:393px;height:min(852px,94dvh);border:5px solid #26262b;border-radius:52px;box-shadow:0 25px 80px #0008}
 #island{top:13px}
 #status{top:2px}
 #homeindicator{bottom:8px}
}
</style>
</head>
<body>
<div id="device">
<div id="wallpaper"></div>
<div id="status"><span id="statusTime">9:41</span><span class="statusright">● <span>Wi-Fi</span> ▰</span></div>
<button id="island" aria-label="다이내믹 아일랜드" onclick="islandAction()"></button>
<div id="screens">
<section id="lock" class="screen active" onclick="unlock(event)">
<div class="lockdate" id="lockdate">10월 22일 목요일</div>
<div class="locktime" id="locktime">9:41</div>
<div id="locknote"><div class="notehead">♡ 백현 팬메이드 알림</div>오늘도 행복한 하루 보내요</div>
<div id="unlockhint"><span>⌃</span>위로 쓸어올려 잠금 해제</div>
</section>
<section id="home" class="screen">
<div class="welcome" id="homedate">목요일, 10월 22일</div>
<h1>안녕, 에리 ♡</h1>
<div class="widget" onclick="openApp('music')"><div class="widgettop"><span>지금 듣는 음악</span><span>♫</span></div><div class="widgettime">BAEKHYUN</div><div style="font-size:13px">오늘도 백현이와 함께</div></div>
<div class="grid" id="appgrid"></div>
</section>
<section id="gallery" class="screen"><div class="page"><div class="bar"><h2>사진</h2><button onclick="openApp('home')">완료</button></div><div class="sectiontitle">최근 항목</div><div class="photoGrid" id="photos"></div><div class="sectiontitle">나의 앨범</div><div class="card">🌸　백현이 모음　　›</div></div><div class="phoneTabs"><button class="selected" onclick="galleryTab('photos')"><b>▦</b>사진</button><button onclick="galleryTab('albums')"><b>▤</b>앨범</button><button onclick="galleryTab('search')"><b>⌕</b>검색</button></div></section>
<section id="viewer" class="screen"><button class="close" onclick="closeViewer()">‹</button><img id="viewerimg" alt="사진"><p id="viewercaption"></p><button onclick="closeViewer()">완료</button></section>
<section id="phone" class="screen"><div class="page"><div class="bar"><h2 id="phoneTitle">최근 통화</h2><button onclick="openApp('contacts')">편집</button></div><div id="phonecontent"></div></div><div class="phoneTabs"><button class="selected" onclick="phoneTab('recents')"><b>◷</b>최근 통화</button><button onclick="phoneTab('favorites')"><b>★</b>즐겨찾기</button><button onclick="phoneTab('contacts')"><b>♙</b>연락처</button><button onclick="phoneTab('keypad')"><b>▦</b>키패드</button></div></section>
<section id="contacts" class="screen"><div class="page"><div class="bar"><h2>연락처</h2><button onclick="openApp('phone')">완료</button></div><input class="search" id="contactSearch" placeholder="검색" oninput="renderContacts(this.value)"><div id="contactlist" class="card"></div></div></section>
<section id="messages" class="screen"><div class="page"><div class="bar"><h2>메시지</h2><button onclick="newChat()">작성</button></div><input class="search" placeholder="검색" oninput="filterRows('messageList',this.value)"><div class="card" id="messageList"></div></div></section>
<section id="chat" class="screen"><div class="chathead"><button onclick="openApp(chatReturn)">‹</button><div class="avatar">♡</div><div class="rowmain"><div class="rowtitle" id="chatName">백현</div><div class="rowdesc">팬메이드 대화</div></div><button onclick="showToast('가상 대화 화면입니다')">ⓘ</button></div><div id="chatbody" class="chatbody"></div><form class="chatinput" onsubmit="sendMessage(event)"><input id="chattext" autocomplete="off" placeholder="메시지 입력"><button class="send">↑</button></form></section>
<section id="kakao" class="screen"><div class="page" style="background:#f8f5ee"><div class="bar"><h2>카카오톡</h2><button onclick="showToast('새 채팅')">＋</button></div><input class="search" placeholder="친구 검색"><div class="card" onclick="startChat('백현','kakao')"><div class="rowitem"><div class="avatar" style="background:#fee500">🐶</div><div class="rowmain"><div class="rowtitle">백현</div><div class="rowdesc">오늘도 고마워요 ♡</div></div><span class="smalltime">오후 9:41</span></div></div><div class="sectiontitle">친구</div><div class="card" onclick="startChat('백현','kakao')"><div class="rowitem"><div class="avatar">♡</div><div class="rowmain"><div class="rowtitle">백현</div><div class="rowdesc">팬메이드 프로필</div></div></div></div></div></section>
<section id="safari" class="screen"><div class="page"><div class="bar"><h2>Safari</h2><button onclick="showToast('탭 보기')">▢</button></div><div style="text-align:center;padding:45px 0 20px"><div style="font-size:50px">🧭</div><h2>어디로 갈까요?</h2></div><form onsubmit="searchWeb(event)"><input class="search" id="webquery" placeholder="검색 또는 웹사이트 이름"><button class="card" style="width:100%;color:#087cff">검색하기　⌕</button></form><div id="webresults"></div><div class="card" style="margin-top:25px">즐겨찾기　♡<div class="rowitem" onclick="searchPreset('백현')">백현 검색　›</div><div class="rowitem" onclick="searchPreset('EXO')">EXO 검색　›</div></div></div><div class="phoneTabs"><button onclick="showToast('이전 페이지')"><b>‹</b>뒤로</button><button onclick="showToast('시작 페이지')"><b>⌂</b>홈</button><button onclick="showToast('탭 목록')"><b>▢</b>탭</button></div></section>
<section id="settings" class="screen"><div class="page"><div class="bar"><h2>설정</h2></div><div class="card"><div class="rowitem"><div class="avatar">♡</div><div class="rowmain"><div class="rowtitle">Baekhyun iPhone</div><div class="rowdesc">팬메이드 기기</div></div>›</div></div><div class="card"><div class="settingrow">에어플레인 모드 <button id="airToggle" class="toggle" onclick="toggleSetting(this)"></button></div><div class="settingrow">Wi-Fi <button class="toggle on" onclick="toggleSetting(this)"></button></div><div class="settingrow">Bluetooth <button class="toggle on" onclick="toggleSetting(this)"></button></div><div class="settingrow">다크 모드 <button class="toggle" onclick="toggleDark(this)"></button></div></div><div class="card"><div class="settingrow">배경화면 <button onclick="showToast('아래 사진 교체 방법을 참고해 줘')">›</button></div><div class="settingrow">일반 <button onclick="showToast('가상 설정입니다')">›</button></div><div class="settingrow">배터리 <span>100%</span></div><div class="settingrow">개인정보 보호 <button onclick="showToast('가상 설정입니다')">›</button></div></div><div class="card"><button onclick="lockPhone()">화면 잠그기</button></div></div></section>
<section id="music" class="screen"><div class="page"><div class="bar"><button onclick="openApp('home')">완료</button><h2>음악</h2><button>•••</button></div><div style="padding:30px 10px;text-align:center"><div class="photoTile" style="width:100%;aspect-ratio:1;border-radius:18px;font-size:20px">BAEKHYUN ♡</div><h2 style="margin-bottom:5px">Bambi</h2><p style="color:#888">BAEKHYUN</p><input type="range" class="slider" min="0" max="100" value="30"><div style="font-size:35px;margin:20px"> <button onclick="showToast('이전 곡')">|◀</button>　<button onclick="playMusic(this)">▶</button>　<button onclick="showToast('다음 곡')">▶|</button></div><p style="color:#888;font-size:12px">팬메이드 음악 플레이어 화면</p></div></div></section>
<section id="control" class="screen"><h2>제어 센터</h2><div class="controlgrid"><div class="controltile"><button onclick="showToast('Wi-Fi 전환')">◉ Wi-Fi</button><button onclick="showToast('Bluetooth 전환')">ᛒ Bluetooth</button></div><div class="controltile"><button onclick="showToast('집중 모드')">☾ 집중 모드</button><button onclick="showToast('비행기 모드')">✈ 비행기</button></div><div class="controltile">밝기<input class="slider" type="range" min="30" max="100" value="100" oninput="document.getElementById('device').style.filter='brightness('+this.value/100+')'"></div><div class="controltile">음량<input class="slider" type="range" min="0" max="100" value="60"></div><div class="controltile"><button onclick="openApp('music')">♫ 음악 재생</button></div><div class="controltile"><button onclick="openApp('settings')">⚙ 설정</button></div></div><button style="margin-top:25px" onclick="closeControl()">완료</button></section>
<section id="shade" class="screen"><h2 id="shadeDate"></h2><div class="card"><b>알림 센터</b><p>♡ 백현 팬메이드 알림</p><p>오늘도 행복한 하루 보내요</p></div><button onclick="closeShade()">닫기</button></section>
</div>
<div id="homeindicator"></div><div id="toast"></div>
</div>
<script>
const $=id=>document.getElementById(id);
const names={gallery:"사진",phone:"전화",messages:"메시지",kakao:"카카오톡",safari:"Safari",settings:"설정",music:"음악",contacts:"연락처"};
const icons=[
["gallery","🌈","icon-photo"],["phone","📞","icon-phone"],["messages","💬","icon-msg"],["kakao","●","icon-kakao"],["safari","🧭","icon-safari"],["settings","⚙","icon-setting"],["music","♫","icon-music"],["notes","▤","icon-notes"],["calendar","22","icon-calendar"],["camera","📷","icon-camera"],["weather","☀","icon-weather"],["clock","◷","icon-clock"],["contacts","♙","icon-files"],["files","▰","icon-files"]
];
const contacts=[{name:"백현",desc:"가장 좋아하는 별 ♡",avatar:"♡"},{name:"EXO",desc:"we are one",avatar:"✦"},{name:"에리",desc:"친구",avatar:"🌸"}];
let current="lock",previous="home",chatReturn="messages",chatApp="messages",activePhoneTab="recents",messages={"백현":[{mine:false,text:"오늘도 고마워요 ♡"}]},toastTimer,gestureStart=null,controlFrom="home";
function clock(){
 const d=new Date();let h=d.getHours()%12||12,m=String(d.getMinutes()).padStart(2,"0");
 $("statusTime").textContent=h+":"+m;
 $("locktime").textContent=h+":"+m;
 const day=["일요일","월요일","화요일","수요일","목요일","금요일","토요일"][d.getDay()];
 $("lockdate").textContent=(d.getMonth()+1)+"월 "+d.getDate()+"일 "+day;
 $("homedate").textContent=day+", "+(d.getMonth()+1)+"월 "+d.getDate()+"일";
 $("shadeDate").textContent=(d.getMonth()+1)+"월 "+d.getDate()+"일";
}
clock();setInterval(clock,15000);
function buildHome(){
 $("appgrid").innerHTML=icons.map(([id,emoji,cls])=>`<button class="app" onclick="openApp('${id}')"><div class="appicon ${cls}">${emoji}</div><div class="appname">${names[id]||({notes:"메모",calendar:"캘린더",camera:"카메라",weather:"날씨",clock:"시계",files:"파일"})[id]}</div></button>`).join("");
}
function showScreen(id){
 document.querySelectorAll(".screen").forEach(s=>s.classList.remove("active"));
 const el=$(id);if(el)el.classList.add("active");
 current=id;
 $("homeindicator").classList.toggle("dark",!["home","lock","control","shade"].includes(id));
 $("status").style.color=["home","lock","control","shade"].includes(id)?"white":"#17171a";
 $("island").style.display=id==="lock"||id==="home"?"block":"none";
}
function openApp(id){
 if(id==="notes"||id==="calendar"||id==="camera"||id==="weather"||id==="clock"||id==="files"){showToast("이 앱은 아직 준비 중이야");return}
 if(id==="home"){showScreen("home");return}
 if(id==="contacts"){renderContacts();showScreen("contacts");return}
 if(id==="phone"){phoneTab(activePhoneTab);showScreen("phone");return}
 if(id==="messages"){renderMessageList();showScreen("messages");return}
 if(id==="gallery"){renderPhotos();showScreen("gallery");return}
 if($(id)){showScreen(id);return}
}
function unlock(e){if(e.target.closest("button"))return;openApp("home")}
function lockPhone(){showScreen("lock")}
function goHome(){showScreen("home")}
function showToast(t){$("toast").textContent=t;$("toast").classList.add("show");clearTimeout(toastTimer);toastTimer=setTimeout(()=>$("toast").classList.remove("show"),1800)}
function islandAction(){if(current==="home")showToast("백현 ♡");else openApp("home")}
function renderPhotos(){
 const p=[["lock.jpg","백현 · 잠금 화면"],["home.jpg","백현 · 홈 화면"],["photo1.jpg","Baekhyun ♡ 01"],["photo2.jpg","Baekhyun ♡ 02"],["photo3.jpg","Baekhyun ♡ 03"],["photo4.jpg","Baekhyun ♡ 04"],["photo5.jpg","Baekhyun ♡ 05"],["photo6.jpg","Baekhyun ♡ 06"],["photo7.jpg","Baekhyun ♡ 07"]];
 $("photos").innerHTML=p.map((x,i)=>`<button class="photoTile" onclick="viewPhoto('${x[0]}','${x[1]}')"><img src="assets/${x[0]}" onerror="this.style.display='none'"><span>${x[1]}</span></button>`).join("");
}
function viewPhoto(file,caption){$("viewerimg").src="assets/"+file;$("viewerimg").onerror=()=>{$("viewerimg").style.display="none"};$("viewerimg").style.display="block";$("viewercaption").textContent=caption;showScreen("viewer")}
function closeViewer(){showScreen("gallery")}
function galleryTab(t){if(t==="albums")showToast("백현이 모음 앨범");else if(t==="search")showToast("사진 검색");else renderPhotos()}
function phoneTab(tab){
 activePhoneTab=tab;$("phoneTitle").textContent=({recents:"최근 통화",favorites:"즐겨찾기",contacts:"연락처",keypad:"키패드"})[tab];
 const el=$("phonecontent");
 if(tab==="keypad"){
 el.innerHTML=`<div style="text-align:center;padding:20px;font-size:26px" id="dialnumber"></div><div class="keypad">${["1","2","3","4","5","6","7","8","9","*","0","#"].map(n=>`<button class="key" onclick="dial('${n}')">${n}<small>${({"2":"ABC","3":"DEF","4":"GHI","5":"JKL","6":"MNO","7":"PQRS","8":"TUV","9":"WXYZ"})[n]||""}</small></button>`).join("")}</div><button class="callbutton" onclick="showToast('가상 통화 화면입니다')">☎</button>`;
 }else{
 const list=tab==="favorites"?contacts.slice(0,1):tab==="contacts"?contacts: [{name:"백현",desc:"오늘 · 발신 통화",avatar:"♡"},{name:"백현",desc:"어제 · 부재중 전화",avatar:"♡"}];
 el.innerHTML=`<div class="card">${list.map(c=>`<div class="rowitem" onclick="startChat('${c.name}','messages')"><div class="avatar">${c.avatar}</div><div class="rowmain"><div class="rowtitle">${c.name}</div><div class="rowdesc">${c.desc}</div></div><button onclick="event.stopPropagation();showToast('가상 통화입니다')">☎</button></div>`).join("")}</div>`;
 }
}
function dial(n){$("dialnumber").textContent+=$("dialnumber").textContent? n:n}
function renderContacts(q=""){
 $("contactlist").innerHTML=contacts.filter(c=>c.name.includes(q||"")).map(c=>`<div class="rowitem" onclick="startChat('${c.name}','messages')"><div class="avatar">${c.avatar}</div><div class="rowmain"><div class="rowtitle">${c.name}</div><div class="rowdesc">${c.desc}</div></div><span>›</span></div>`).join("")||"검색 결과가 없어";
}
function renderMessageList(){
 $("messageList").innerHTML=Object.keys(messages).map(n=>{let last=messages[n].slice(-1)[0];return `<div class="rowitem" onclick="startChat('${n}','messages')"><div class="avatar">♡</div><div class="rowmain"><div class="rowtitle">${n}</div><div class="rowdesc">${escapeHTML(last?.text||"대화 시작하기")}</div></div><span class="smalltime">지금</span></div>`}).join("");
}
function filterRows(id,q){$(id).querySelectorAll(".rowitem").forEach(r=>r.style.display=r.innerText.toLowerCase().includes(q.toLowerCase())?"flex":"none")}
function newChat(){startChat("백현","messages")}
function startChat(name,app){
 chatReturn=app==="kakao"?"kakao":"messages";chatApp=app;$("chatName").textContent=name;
 if(!messages[name])messages[name]=[];
 renderChat();showScreen("chat");
}
function renderChat(){
 const name=$("chatName").textContent;
 $("chatbody").innerHTML=(messages[name]||[]).map(m=>`<div class="bubble ${m.mine?"mine":""}">${escapeHTML(m.text)}</div>`).join("");
 $("chatbody").scrollTop=$("chatbody").scrollHeight;
}
function sendMessage(e){
 e.preventDefault();const inp=$("chattext"),v=inp.value.trim();if(!v)return;
 const n=$("chatName").textContent;if(!messages[n])messages[n]=[];
 messages[n].push({mine:true,text:v});inp.value="";renderChat();
}
function searchWeb(e){
 e.preventDefault();const q=$("webquery").value.trim();if(!q)return;
 $("webresults").innerHTML=`<div class="card"><b>“${escapeHTML(q)}” 검색</b><p>이 화면은 가상 Safari 검색 시뮬레이션이야.</p><p>실제 검색 결과가 필요하면 아래 버튼을 눌러 Safari에서 열 수 있어.</p><button style="color:#087cff" onclick="window.open('https://www.google.com/search?q='+encodeURIComponent($('webquery').value),'_blank')">실제 웹 검색 ↗</button></div>`;
}
function searchPreset(q){$("webquery").value=q;searchWeb(new Event("submit",{cancelable:true,preventDefault(){}}))}
function toggleSetting(el){el.classList.toggle("on")}
function toggleDark(el){el.classList.toggle("on");document.body.style.filter=el.classList.contains("on")?"brightness(.8)":"none"}
function playMusic(el){el.textContent=el.textContent==="▶"?"Ⅱ":"▶";showToast("가상 플레이어")}
function escapeHTML(s){return String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]))}
function openControl(){controlFrom=current;showScreen("control")}
function closeControl(){showScreen(controlFrom)}
function openShade(){showScreen("shade")}
function closeShade(){showScreen("home")}
let touchY=null,touchX=null;
$("device").addEventListener("touchstart",e=>{touchY=e.touches[0].clientY;touchX=e.touches[0].clientX},{passive:true});
$("device").addEventListener("touchend",e=>{
 if(touchY===null)return;
 const dy=e.changedTouches[0].clientY-touchY,dx=e.changedTouches[0].clientX-touchX;
 if(touchY<65&&dy>90&&current!=="lock"){openShade()}
 else if(touchY<65&&dy>90&&current==="lock"){showToast("알림")}
 else if(touchY<65&&dy< -90){openControl()}
 else if(touchY>window.innerHeight-65&&dy< -45){if(current==="lock")goHome();else if(current==="control")closeControl();else if(current==="shade")closeShade();else goHome()}
 touchY=null;touchX=null;
},{passive:true});
$("homeindicator").addEventListener("click",()=>{if(current==="lock")goHome();else if(current==="control")closeControl();else if(current==="shade")closeShade();else goHome()});
$("homeindicator").addEventListener("touchstart",e=>{gestureStart=e.touches[0].clientY},{passive:true});
$("homeindicator").addEventListener("touchend",e=>{if(gestureStart!==null&&gestureStart-e.changedTouches[0].clientY>15){if(current==="lock")goHome();else if(current==="control")closeControl();else if(current==="shade")closeShade();else goHome()}gestureStart=null},{passive:true});
buildHome();renderPhotos();phoneTab("recents");renderContacts();renderMessageList();
</script>
</body>
</html>
